  },
  "segments": [
    {
      "seg_id": 1,
      "type": "sentence",
      "section": "background",
      "path": null,
      "ko_txt": "대부분의 뇌졸중은 뇌경색이 원인이다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 2,
      "type": "sentence",
      "section": "background",
      "path": null,
      "ko_txt": "허혈성 대뇌 조직(ischaemic cerebral tissue)은 세포독성 부종(cytotoxic oedema)으로 진전되는 경향이 있으며, 만약 혈액과 뇌를 가르는 벽이 없어지면 세포독성 부종은 혈관성 부종(vasogenic oedema)으로 이어진다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 3,
      "type": "sentence",
      "section": "background",
      "path": null,
      "ko_txt": "광범위한 뇌경색(Large infarct)은 치명적인 대형 부종으로 진전될 수 있다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 4,
      "type": "sentence",
      "section": "background",
      "path": null,
      "ko_txt": "이론적으로는 조기에 코르티코스테로이드로 치료하면 세포독성과 혈관성 부종 두 가지 모두의 발병을 낮추는데 도움이 되어 뇌졸중 이후의 임상적 결과가 개선된다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 5,
      "type": "sentence",
      "section": "objectives",
      "path": null,
      "ko_txt": "급성으로 추정되는 허혈성 뇌졸중에서 코르티코스테로이드의 효과를 평가한다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 6,
      "type": "sentence",
      "section": "search_methods",
      "path": null,
      "ko_txt": "The Cochrane Stroke Group Trials Register를 검색했다(최종 검색: 2011년 2월 17일).",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 7,
      "type": "sentence",
      "section": "선정 기준",
      "path": null,
      "ko_txt": "(추정 또는 확실한) 급성 허혈성 뇌졸중 환자 치료를 위한 코르티코스테로이드를 위약 또는 대조 그룹과 비교하여 발표한 무작위시험을 선정했다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 8,
      "type": "sentence",
      "section": "선정 기준",
      "path": null,
      "ko_txt": "뇌졸중 발병 후 48시간 내에 치료를 시작한 경우와 임상적 결과를 평가한 시험을 포함시켰다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 9,
      "type": "sentence",
      "section": "자료 수집 및 분석",
      "path": null,
      "ko_txt": "연구 저자 2명이 독립적으로 선정 기준을 적용하여 시험의 질을 평가하고 데이터를 추출했다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 10,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "466명을 대상으로 한 8건의 시험이 포함되었다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 11,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "대부분의 시험에서 비뚤림과 관련이 있을 수도 있는 시험의 질에 관한 상세한 내용은 입수할 수 없었다. 1년 내의 사망 가능성(odds)은 다르지 않았다 (가능성 비율(odds ratio, OR) 0.87, 95% 신뢰 구간 (confidence interval, CI) 0.57 ‐ 1.34).",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 12,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "치료를 해도 생존자들의 기능적 결과가 개선되는 것 같지 않았다. 7건의 시험에서는 신경 손상을 보고했으나 공통적인 측정 방법 또는 시간 간격(time interval)을 사용하지 않았기 때문에 데이터를 통합할 수 없었다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 13,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "각 시험의 결과는 일치하지 않았다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 14,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "유일하게 보고된 부작용은 두 그룹 모두에서 소수의 위장 출혈, 감염 및 고혈당증(hyperglycaemia) 악화였다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 15,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "이전 발표 이후에 결과가 달라지지 않았다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 16,
      "type": "sentence",
      "section": "authors_conclusions",
      "path": null,
      "ko_txt": "급성으로 추정되는 허혈성 뇌졸중 환자에 대한 코르티코스테로이드 치료를 평가하기 위한 근거는 충분하지 않다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 17,
      "type": "sentence",
      "section": "authors_conclusions",
      "path": null,
      "ko_txt": "이전 발표 이후에 결과가 달라지지 않았다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 18,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "급성 허혈성 뇌졸중에 코르티코스테로이드 치료를 하면 편익이 있다는 근거는 없다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 19,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "뇌 일부에서 동맥이 폐쇄되어 발생하는 뇌졸중은 뇌의 같은 부위에 종창(swelling)을 발생시킨다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 20,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "이 종창은 압력 효과(pressure effects)를 가져와 추가로 뇌 세포를 죽이거나 또는 손상은 됐지만 재생이 가능한 뇌 세포의 회복을 지연시킨다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 21,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "이 종창 크기가 작으면 인접한 부분의 압력이 떨어지며 죽은 뇌 세포 수가 줄어 손상된 뇌 세포가 빨리 회복된다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 22,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "이러한 뇌 종창 크기를 작게하여 뇌 세포의 손상을 줄이고 회복 속도를 빨리하기 위해 코르티코스테로이드를 사용해 왔다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 23,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "그러나, 466명을 대상으로 한 8건의 시험으로부터 입수한 소수의 부적당한 근거를 기반으로 한 본 연구에서는 코르티코스테로이드가 사망자를 줄이거나 또는 생존자들의 기능 결과를 개선하는데 편익이 있다는 점을 확인하지 못 했다.",
      "en_txt": null,
      "align_score": null
    }
  ]
}