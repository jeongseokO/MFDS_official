  },
  "segments": [
    {
      "seg_id": 1,
      "type": "sentence",
      "section": "background",
      "path": null,
      "ko_txt": "급성 허혈성 뇌졸중 환자는 혈소판이 활성화됨으로 인해 혈전 및 뇌동맥 폐색이 생기고 이는 뇌의 부분적인 손상으로 이어질 가능성이 있습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 2,
      "type": "sentence",
      "section": "background",
      "path": null,
      "ko_txt": "이러한 손상은 뇌졸중 증세를 일으킵니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 3,
      "type": "sentence",
      "section": "background",
      "path": null,
      "ko_txt": "혈소판 요법은 허혈에 의해서 손상되는 뇌의 용적을 줄이면서 허혈성 뇌졸중의 조기 재발 위험을 낮춤으로 조기 사망위험을 감소시키며 생존자의 장기적 예후 개선을 가져올 가능성이 있습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 4,
      "type": "sentence",
      "section": "background",
      "path": null,
      "ko_txt": "그러나 항혈소판 요법은 사망이나 장애로 이어지는 두개 내 출혈의 위험도 높일 수 있습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 5,
      "type": "sentence",
      "section": "objectives",
      "path": null,
      "ko_txt": "급성 허혈성 뇌졸중으로 추정되는 환자에서 즉각적인 경구 항혈소판 요법(즉, 가능한 한 빨리 시작하고 뇌졸중 발병 후 2주 이내에 시작)의 효능과 안전성을 평가합니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 6,
      "type": "sentence",
      "section": "search_methods",
      "path": null,
      "ko_txt": "Cochrane Stroke Group Trials Register, CENTRAL, MEDLINE Ovid, Embase Ovid 및 2개의 시험 레지스터를 검색하고 2020년 8월에 전방 참조/인용 참조 검색을 수행했습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 7,
      "type": "sentence",
      "section": "선정 기준",
      "path": null,
      "ko_txt": "허혈성 뇌졸중이 확실하거나 추정되는 사람들을 대상으로 경구 항혈소판 요법(뇌졸중 14일 이내에 시작)을 대조군과 비교한 무작위 대조 시험(RCT).",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 8,
      "type": "sentence",
      "section": "자료 수집 및 분석",
      "path": null,
      "ko_txt": "2명의 리뷰어가 개별적으로 선택 기준을 적용하여 시험의 질을 평가했습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 9,
      "type": "sentence",
      "section": "자료 수집 및 분석",
      "path": null,
      "ko_txt": "포함된 시험에 대해 데이터를 추출하고 교차 확인했습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 10,
      "type": "sentence",
      "section": "자료 수집 및 분석",
      "path": null,
      "ko_txt": "그들은 편향 위험 1(RoB1) 도구를 사용하여 각 연구의 편향 위험을 평가하고 GRADE 접근법을 사용하여 각 결과에 대한 증거의 전반적인 확실성을 평가했습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 11,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "본 리뷰는 42,226명의 참가자가 포함된 11개의 연구를 포함했습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 12,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "마지막 업데이트 이후 3개의 새로운 연구가 추가되었습니다(참가자 743명).",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 13,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "이 검토의 이전 버전에 따르면, 1일 1회 아스피린 160mg에서 300mg을 테스트한 2건의 시험이 발병 후 48시간 이내에 시작되었고, 데이터의 96%에 기여했습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 14,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "비뚤림 위험은 낮았습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 15,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "최대 추적 관찰 기간은 6개월이었습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 16,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "치료를 받은 환자들은 추적 종료 시점에 사망 또는 의존성이 감소한 것을 확인했습니다 (교차비(OR) 0.95, 95% 신뢰 구간(CI) 0.91~0.99, 7건의 RCT, 42,034명의 참가자, 중간 정도의 확실성 증거).",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 17,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "아스피린으로 처방받은 1000명당 13명이 사망이나 장애를 피할 것입니다(추가 유익한 결과를 위해 치료하는 데 필요한 수 79명당 1명).",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 18,
      "type": "sentence",
      "section": "authors_conclusions",
      "path": null,
      "ko_txt": "허혈성 뇌졸중 발병으로부터 48시간 이내에 개시한 아스피린 160 mg~300 mg의 연일 경구 투여(삼키지 못하는 사람에게는 경비 위관 또는 경직장으로 투여)에 따른 항 혈소판 요법에서는 사망과 장애의 위험을 유의미하게 감소시켰고 조기 출혈성 합병증의 주요 위험이 없는 조기 재발성 허혈성 뇌졸중의 위험도 줄이고, 장기적인 결과는 개선되었습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 19,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "우리는 경구 항혈소판 약이 사망자 수를 줄이고 생존자들의 장기적 결과를 개선하는지 확인하기 위해 급성 허혈성 뇌졸중 환자에서 경구 항혈소판 요법 대 플라시보 효과 또는 치료하지 않았을 때의 안전성과 효과를 비교하고 싶었습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 20,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "뇌졸중의 대부분은 대체로 혈전으로 인한 뇌동맥의 갑작스러운 폐색으로 발생한다(허혈성 뇌졸중).",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 21,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "아스피린과 같은 항혈소판제의 즉각적 치료는 새로운 혈전이 형성되는 것을 방지할 수 있으므로 뇌졸중 이후 회복을 개선할 수 있습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 22,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "그러나 항혈소판제는 뇌출혈을 유발할 수 있으며, 이는 모든 이점을 상쇄할 수 있습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 23,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "2020년 8월까지 리뷰에 포함할 11개의 연구를 확인했습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 24,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "이 연구에는 42,226명의 참가자가 포함되었습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 25,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "마지막 업데이트 이후 3개의 새로운 연구가 추가되었습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 26,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "이 리뷰의 이전 버전에 따르면 2개의 연구가 데이터의 96%를 기여했습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 27,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "검토에 참여한 대부분의 참가자는 70세 이상의 고령자였습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 28,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "남성과 여성은 시험에서 거의 동등하게 대표되었습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 29,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "포함된 연구 대상 간에 뇌졸중 중증도에 약간의 차이가 있는 것으로 나타났습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 30,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "예정된 치료 기간은 5일에서 3개월까지 다양했고 예정된 추적 기간은 10일에서 6개월까지 다양했습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 31,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "뇌졸중 증상이 시작된 후 48시간 이내에 160mg에서 300mg 가량 매일 투여된 아스피린은 생명을 구하고 처음 2주 동안 추가 뇌졸중이 발생할 위험을 줄였습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 32,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "치료가 발병 후 48시간이 넘었지만 14일 이내에 시작된 경우, 리뷰 및 기타 외부 데이터의 증거가 부족한 점이 있지만 이 단계에서 시작하는 아스피린 투여도 유익하다고 주장합니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 33,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "허혈성 뇌졸중 발병으로부터 48시간 이내에 개시한 아스피린 160 mg~300 mg의 연일 경구 투여(삼키지 못하는 사람에게는 경비 위관 또는 경직장으로 투여)에 따른 항 혈소판 요법에서는 조기 출혈성 합병증의 중대한 위험을 수반하지 않은 채로 허혈성 뇌졸중의 조기 재발 위험을 줄였으며 장기적 예후를 개선했습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 34,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "본 연구의 근거는 거의 모두 아스피린 시험에서 도출되었습니다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 35,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "연구 결과에 기여한 근거의 질은 대체로 양호하였습니다.",
      "en_txt": null,
      "align_score": null
    }
  ]
