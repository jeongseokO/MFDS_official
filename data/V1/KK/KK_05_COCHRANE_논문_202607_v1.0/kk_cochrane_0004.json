  "segments": [
    {
      "seg_id": 1,
      "type": "sentence",
      "section": "background",
      "path": null,
      "ko_txt": "인후염은 사람들이 진료를 받고 항생제를 처방받는 일반적인 이유이다. 1차 의학에서 항생제 남용이 우려되므로 인후통 치료 및 2차 합병증 예방에 대한 항생제의 효능을 확립하는 것이 중요하다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 2,
      "type": "sentence",
      "section": "objectives",
      "path": null,
      "ko_txt": "소아 및 성인 환자의 인후통 증상을 감소시키기 위한 항생제의 효과를 평가한다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 3,
      "type": "sentence",
      "section": "search_methods",
      "path": null,
      "ko_txt": "CENTRAL 2021, 2호, MEDLINE(1966년 1월 ~ 2021년 4월 1주차), Embase(1990년 1월 ~ 2021년 4월) 및 2개의 시험 레지스트리(2021년 4월 6일 검색)를 검색했다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 4,
      "type": "sentence",
      "section": "선정 기준",
      "path": null,
      "ko_txt": "인후염 증상에 대한 의료 치료를 원하는 어린이와 성인의 전형적인 인후염 증상 또는 합병증을 평가하는 항생제 대 대조군의 무작위 대조 시험(RCT) 또는 준 RCT를 포함했다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 5,
      "type": "sentence",
      "section": "자료 수집 및 분석",
      "path": null,
      "ko_txt": "Cochrane에서 권장하는 표준 방법론 절차를 사용했다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 6,
      "type": "sentence",
      "section": "자료 수집 및 분석",
      "path": null,
      "ko_txt": "두 명의 리뷰 작성자가 독립적으로 연구를 선별하고 데이터를 추출하여 토론을 통해 의견의 차이를 해결했다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 7,
      "type": "sentence",
      "section": "자료 수집 및 분석",
      "path": null,
      "ko_txt": "추가 정보를 위해 3개 연구의 시험 저자에게 연락했다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 8,
      "type": "sentence",
      "section": "자료 수집 및 분석",
      "path": null,
      "ko_txt": "GRADE를 사용하여 1차 결과(3일 및 1주째 인후통) 및 2차 결과(발열 및 두통 증상 및 급성 류마티스열, 급성 사구체신염, 급성 중이염, 급성 부비동염 및 후두염)에 대한 항생제의 효능에 대한 근거의 확실성을 평가했다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 9,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "15,337건의 인후통이 있는 29건의 시험을 포함했다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 10,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "포함된 연구의 대부분은 심각한 합병증(특히 급성 류마티스열)의 발병률이 오늘날보다 훨씬 높았던 1950년대에 수행되었다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 11,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "인후통 및 호흡기 증상에 대한 임상 항생제 시험이 아직 진행 중이지만 검토에 포함해야 하는 위약 또는 '무치료' 대조군을 포함하는 것은 이례적이다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 12,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "참가자의 연령은 1세 미만에서 50세 이상까지 다양했지만 모든 연구에서 대부분의 참가자는 성인이었다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 13,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "모든 연구에서 인후통 증상을 보이는 환자를 모집했지만, 그 중 세균과 바이러스 병인을 구별하는 연구는 거의 없었다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 14,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "일부 연구에서는 치료 할당 절차가 명확하지 않고 눈가림이 부족하여 비뚤림이 도입되었을 수 있다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 15,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "항생제로 인한 위해는 저조하거나 일관되지 않게 보고되었으므로 이 검토에서 정량화되지 않았다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 16,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "1.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 17,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "증상",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 18,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "3일째의 인후통과 두통은 항생제를 사용함으로써 감소했지만, 위약군 또는 무치료군 참가자의 82%가 1주일까지 증상이 없었다. 3일차에 인후통 증상의 감소(위험비(RR) 0.70, 95% 신뢰 구간(CI) 0.60~0.80, 16개 연구, 참가자 3,730명, 중간 정도의 확실성 근거)는 두 치료 그룹의 많은 사례가 이 시간까지 해결되었기 때문에 절대 수치(RR 0.50, 95% CI 0.34 ~ 0.75, 연구 14개, 참가자 3083명, 중간 정도의 확실성 근거)에서 1주일보다 더 컸다. 3일차에 1개의 인후통을 예방하기 위해 추가적인 유익한 결과(NNTB)를 치료하는 데 필요한 수는 6회 미만이었다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 19,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "첫째 주에는 18회였다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 20,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "위약 또는 무치료에 비해 항생제는 3일째에 열을 유의하게 감소시키지 않았지만(RR 0.75, 95% CI 0.53~1.07; 8건의 연구, 1443명의 참가자, 높은 확실성 근거), 3일째에 두통을 감소시켰다(RR 0.49, 95% CI 0.34 ~ 0.70, 4건의 연구, 1020명의 참가자, 높은 확실성 근거).",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 21,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "2.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 22,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "화농성 합병증",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 23,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "화농성 합병증의 유병률은 낮았지만 항생제는 14일 이내에 급성 중이염의 발병률을 감소시켰고(Peto odds ratio(OR) 0.21, 95% CI 0.11~0.40; 10건의 연구, 3646명의 참가자; 높은 확실성 근거) 2개월 이내 후두염(Peto OR 0.16, 95% CI 0.07~0.35, 8개의 연구, 2433명의 참가자, 높은 확실성 근거)은 위약을 받았거나 치료를 받지 않았지만 14일 이내에 급성 부비동염이 아닌 환자와 비교하였다(Peto OR 0.46, 95% CI 0.10) ~ 2.05, 8건의 연구, 2387명의 참가자, 높은 확실성 근거).",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 24,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "3.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 25,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "비화농성 합병증",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 26,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "급성 사구체신염의 사례가 너무 적어 이 합병증에 대해 위약과 비교하여 항생제의 보호 효과가 있는지 여부를 판단할 수 없었다(Peto OR 0.07, 95% CI 0.00~1.32, 연구 10개, 참가자 5,147명, 근거가 낮음).",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 27,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "항생제는 대조군에 비해 2개월 이내에 급성 류마티스열을 감소시켰다(Peto OR 0.36, 95% CI 0.26~0.50, 18개 연구, 12,249명의 참가자, 중간 정도의 확실성 근거).",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 28,
      "type": "sentence",
      "section": "main_results",
      "path": null,
      "ko_txt": "급성 류마티스열의 전반적인 유병률은 특히 후기 연구에서 매우 낮았다는 점에 유의해야 한다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 29,
      "type": "sentence",
      "section": "authors_conclusions",
      "path": null,
      "ko_txt": "항생제는 아마도 인후통을 경험하는 사람들의 수를 줄이고 두통 및 일부 인후통 합병증의 가능성을 줄인다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 30,
      "type": "sentence",
      "section": "authors_conclusions",
      "path": null,
      "ko_txt": "증상에 대한 영향이 작을 수 있으므로 임상의는 이러한 효과를 생성하기 위해 항생제를 사용하는 것이 임상적으로 정당한지 여부와 인후통의 근본 원인이 세균성 기원일 가능성이 있는지 여부를 개별적으로 판단해야 한다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 31,
      "type": "sentence",
      "section": "authors_conclusions",
      "path": null,
      "ko_txt": "또한, 적당한 증상 감소와 항균제 내성의 잠재적 위험 사이의 균형을 인식해야 한다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 32,
      "type": "sentence",
      "section": "authors_conclusions",
      "path": null,
      "ko_txt": "증상의 중증도를 측정하려는 시도는 거의 없다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 33,
      "type": "sentence",
      "section": "authors_conclusions",
      "path": null,
      "ko_txt": "항생제가 증상의 심각성과 지속 기간을 줄인다면 이 메타 분석에서 항생제의 이점이 과소 평가되었을 것이다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 34,
      "type": "sentence",
      "section": "authors_conclusions",
      "path": null,
      "ko_txt": "또한, 저소득 국가, 고소득 국가의 사회경제적 빈곤층, 아동에 대한 더 많은 실험이 필요하다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 35,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "항생제가 증상을 치료하고 인후통과 관련된 잠재적인 합병증을 줄이는 데 효과적입니까?",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 36,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "인후염은 박테리아나 바이러스에 의한 감염이다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 37,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "통증이나 불편함이 가장 두드러진 특징이다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 38,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "그러나 발열과 두통도 동반되는 흔한 증상이다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 39,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "일부 사람들은 합병증을 일으키지만 일반적으로 빠르게(3~4일 후) 회복된다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 40,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "심각하지만 드문 합병증은 심장과 관절에 영향을 미치는 류마티스열이다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 41,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "다른 합병증으로는 부비동, 중이, 편도선 및 신장의 급성 감염이 있다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 42,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "항생제는 박테리아에 의한 감염을 감소시키지만 바이러스에 의한 감염은 감소시키지 않으며 설사, 발진 및 기타 부작용을 유발할 수 있다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 43,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "또한 커뮤니티는 이에 대한 저항을 구축한다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 44,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "2021년 업데이트에는 15,337건의 인후통에 대한 29건의 시험이 포함되어 있다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 45,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
      "ko_txt": "포함된 모든 연구는 항생제가 인후염, 발열, 두통 또는 더 심각한 합병증의 발생을 감소시키는 데 도움이 되는지 여부를 결정하는 무작위 대조 시험(참가자를 두 개 이상의 치료 그룹 중 하나에 무작위로 할당하는 연구 유형)이었다.",
      "en_txt": null,
      "align_score": null
    },
    {
      "seg_id": 46,
      "type": "sentence",
      "section": "plain_language_summary",
      "path": null,
