      "path": null,
      "ko_txt": null,
      "en_txt": "All patients are required to be scheduled for a total mastectomy with or without surgery for axillary nodal staging (axillary lymph nodes dissection or sentinel lymph node biopsy) for their breast cancer.",
      "align_score": null
    },
    {
