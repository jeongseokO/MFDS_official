    {
      "seg_id": 18,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "Daily activity and quality of life is reduced by limited range of motion of shoulder and pain after breast surgery.",
      "align_score": null
    },
    {
      "seg_id": 19,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "The arm and shoulder morbidity in patient who received total mastectomy was much higher than that in patient who received breast conserving surgery.",
      "align_score": null
    },
    {
      "seg_id": 20,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "Adhesion after mastectomy is considered an important precipitating factor of limited range of shoulder motion, pectoralis tightness and shoulder pain.",
      "align_score": null
    },
    {
      "seg_id": 21,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "Guardix-sol.",
      "align_score": null
    },
    {
      "seg_id": 22,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "which is composed of sodium hyaluronate and sodium carboxymethyl cellulose, is an effective agent that can be used as a surgical adjuvant to decrease adhesion in the various surgery.",
      "align_score": null
    },
    {
      "seg_id": 23,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "The aim of study is to evaluate the anti-adhesive effect of Guardix-sol.",
      "align_score": null
    },
    {
      "seg_id": 24,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "for the prevention of arm and shoulder morbidity after total mastectomy.",
      "align_score": null
    },
    {
      "seg_id": 25,
      "type": "sentence",
      "section": "8. 연구설계_중재상세설명",
      "path": null,
      "ko_txt": null,
      "en_txt": "Patients who were enrolled in this study were randomized to either the Guardix group or the no-treatment control group after completion of the main portion of the operation and just before skin closure.",
      "align_score": null
    },
    {
      "seg_id": 26,
      "type": "sentence",
      "section": "8. 연구설계_중재상세설명",
      "path": null,
      "ko_txt": null,
      "en_txt": "In the Guardix group, 5mL Guardix-sol is evenly sprayed to the exposed pectoralis major muscle after mastectomy using the spray applicator.",
      "align_score": null
    },
    {
      "seg_id": 27,
      "type": "sentence",
      "section": "8. 연구설계_중재상세설명",
      "path": null,
      "ko_txt": null,
      "en_txt": "Control group patients receive standard surgical procedure and were not administered a placebo.",
      "align_score": null
    },
    {
      "seg_id": 28,
      "type": "sentence",
      "section": "8. 연구설계_군_1.중재군_군명",
      "path": null,
      "ko_txt": null,
      "en_txt": "Guardix",
      "align_score": null
    },
    {
