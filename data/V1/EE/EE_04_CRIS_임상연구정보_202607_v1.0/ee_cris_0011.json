    {
      "seg_id": 30,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "Various endoscopic tools have been tried to reduce polyp missing rate which has been reported to be 20-25%.",
      "align_score": null
    },
    {
      "seg_id": 31,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "Transparent cap-assisted colonoscopy has been suggested to improve visualization of the lesion that are difficult to access, such as tangentially located lesions and those located within a limited luminal space.",
      "align_score": null
    },
    {
      "seg_id": 32,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "Chromoendoscopy with indigocarmine spraying was reported to increases the detection rates of polyp, especially in right colon and rectum.",
      "align_score": null
    },
    {
      "seg_id": 33,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "However, there also have been mixed results regarding polyp detection rates of the endoscopic methods.",
      "align_score": null
    },
    {
      "seg_id": 34,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "Moreover, there is no data regarding the impact of the screening tools on longterm recurrence rate of colorectal polyp.",
      "align_score": null
    },
    {
      "seg_id": 35,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "The investigators plan to conduct a multi-center, randomized controlled trial to investigate the efficacy of cap-assisted chromoendoscopy as a screening test for colorectal polyp, and the impact on 3-year polyp recurrence rate.",
      "align_score": null
    },
    {
      "seg_id": 36,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "This study will be performed using web-based research network, e-VELOS in Korea.",
      "align_score": null
    },
    {
      "seg_id": 37,
      "type": "sentence",
      "section": "8. 연구설계_중재상세설명",
      "path": null,
      "ko_txt": null,
      "en_txt": "transparent cap is applied at the tip of colonoscope, and 10-15cc of 0.15% indigocarmine was sprayed at each segment of colon under colonoscopy",
      "align_score": null
    },
    {
      "seg_id": 38,
      "type": "sentence",
      "section": "8. 연구설계_군_1.중재군_군명",
      "path": null,
      "ko_txt": null,
      "en_txt": "cap assisted chromocolonoscopy",
      "align_score": null
    },
    {
      "seg_id": 39,
      "type": "sentence",
      "section": "8. 연구설계_군_1.중재군_상세내용",
      "path": null,
      "ko_txt": null,
      "en_txt": "intervention group: a transparent cap is applied at the tip of colonoscope, and 10-15cc of 0.15% indigocarmine was sprayed at each segment of colon under colonoscopy control group: convetional colonoscopy",
      "align_score": null
    },
