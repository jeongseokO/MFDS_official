    {
      "seg_id": 31,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "- The prevalence of cardiovascular disease is increasing very rapidly and the prevalence of diabetes and metabolic syndrome, as risk for the cardiovascular disease, are increasing, too.",
      "align_score": null
    },
    {
      "seg_id": 32,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "However, it has never been proved whether statins show the benefit on the prevention of cardiovascular disease to the Korean population.",
      "align_score": null
    },
    {
      "seg_id": 33,
      "type": "sentence",
      "section": "7. 연구요약",
      "path": null,
      "ko_txt": null,
      "en_txt": "The purpose of current study is to prove if long-term trial of statin may exert the preventive effect on the Korean subjects with diabetes and other multiple risk factors including metabolic syndrome, whose serum total cholesterol levels are 220 mg/dl or less.",
      "align_score": null
    },
    {
      "seg_id": 34,
      "type": "sentence",
      "section": "8. 연구설계_중재상세설명",
      "path": null,
      "ko_txt": null,
      "en_txt": "Administration of pitavastatin 2 mg one tablet, once a day in the morning or non-medication - Follow-up for 60 months after LPI",
      "align_score": null
    },
    {
      "seg_id": 35,
      "type": "sentence",
      "section": "8. 연구설계_군_1.중재군_군명",
