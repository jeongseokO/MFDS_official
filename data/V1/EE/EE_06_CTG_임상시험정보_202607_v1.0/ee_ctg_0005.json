    {
      "seg_id": 34,
      "type": "table",
      "section": null,
      "path": "Participant Flow.Arm/Group Description.Treatment Deferral",
      "ko_txt": null,
      "en_txt": "IV (in the vein) treatment deferred until retinitis progressed, either:\n\n5 mg/kg IV (in the vein) of body weight once weekly for two weeks, then maintenance therapy with cidofovir, 3mg/kg once every 2 weeks, or\n\n5mg/kg IV (in the vein) once weekly for 2 weeks, then maintenance therapy with cidofovir, 5mg/kg once every two weeks.\n\nCidofovir: Three groups:\n\n1. the deferral group, treatment deferred until retinitis progressed\n2. Low-dose cidofovir group, 5 mg/kg of body weight once weekly for two weeks, then maintenance therapy with cidofovir, 3mg/kg once every 2 weeks.\n3. High-dose cidofovir group, 5mg/kg once weekly for 2 weeks, then maintenance therapy with cidofovir, 5mg/kg once every two weeks.",
      "align_score": null
    },
    {
      "seg_id": 35,
      "type": "table",
      "section": null,
      "path": "Participant Flow.Arm/Group Description.Cidofovir (Low Dose)",
      "ko_txt": null,
      "en_txt": "5 mg/kg IV (in the vein) of body weight once weekly for two weeks, then maintenance therapy with cidofovir, 3mg/kg once every 2 weeks\n\nCidofovir: Three groups:\n\n1. the deferral group, treatment deferred until retinitis progressed\n2. Low-dose cidofovir group, 5 mg/kg of body weight once weekly for two weeks, then maintenance therapy with cidofovir, 3mg/kg once every 2 weeks.\n3. High-dose cidofovir group, 5mg/kg once weekly for 2 weeks, then maintenance therapy with cidofovir, 5mg/kg once every two weeks.",
      "align_score": null
    },
