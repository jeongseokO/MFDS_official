#!/bin/bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_DIR="${REPO_ROOT}/gradio_app"

if [[ -f "${REPO_ROOT}/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "${REPO_ROOT}/.env"
    set +a
fi

export HF_HOME="${HF_HOME:-${REPO_ROOT}/.cache/huggingface}"
export HF_HUB_CACHE="${HF_HUB_CACHE:-${HF_HOME}/hub}"
export HUGGINGFACE_HUB_CACHE="${HUGGINGFACE_HUB_CACHE:-${HF_HUB_CACHE}}"
unset TRANSFORMERS_CACHE

export VLLM_ATTENTION_BACKEND="${VLLM_ATTENTION_BACKEND:-FLASH_ATTN}"
export VLLM_USE_FLASHINFER_SAMPLER="${VLLM_USE_FLASHINFER_SAMPLER:-0}"
export VLLM_ENFORCE_EAGER="${VLLM_ENFORCE_EAGER:-1}"
export MFDS_DISABLE_VLLM_FLASHINFER="${MFDS_DISABLE_VLLM_FLASHINFER:-1}"
export MFDS_FAISS_DB_ROOT="${MFDS_FAISS_DB_ROOT:-${REPO_ROOT}/resources/faiss/dev_with_doc_id}"
export FEWSHOT_APP_PROGRESS_CHUNK_SIZE="${FEWSHOT_APP_PROGRESS_CHUNK_SIZE:-32}"
export FEWSHOT_APP_AUTO_BATCH_TOKEN_BUDGET="${FEWSHOT_APP_AUTO_BATCH_TOKEN_BUDGET:-12288}"
export MFDS_STREAMING_TRANSLATION="${MFDS_STREAMING_TRANSLATION:-1}"
export MFDS_RAW_STREAM_LOG="${MFDS_RAW_STREAM_LOG:-1}"
export MFDS_RETRIEVAL_BACKEND="${MFDS_RETRIEVAL_BACKEND:-faiss}"
export GRADIO_TEMP_DIR="${GRADIO_TEMP_DIR:-${REPO_ROOT}/.cache/gradio_tmp}"
export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"
mkdir -p "${GRADIO_TEMP_DIR}"

PYTHON_BIN="${PYTHON_BIN:-python}"
if command -v "${PYTHON_BIN}" >/dev/null 2>&1; then
    PYTHON_BIN_RESOLVED="$(command -v "${PYTHON_BIN}")"
elif [[ -x "${PYTHON_BIN}" ]]; then
    PYTHON_BIN_RESOLVED="${PYTHON_BIN}"
else
    echo "Python executable not found: ${PYTHON_BIN}" >&2
    echo "Set PYTHON_BIN in .env, for example /path/to/conda/envs/mfds/bin/python" >&2
    exit 1
fi
PYTHON_BIN_DIR="$(cd "$(dirname "${PYTHON_BIN_RESOLVED}")" && pwd)"
export PATH="${PYTHON_BIN_DIR}:${PATH}"

cd "${APP_DIR}"
exec "${PYTHON_BIN_RESOLVED}" "${APP_DIR}/fewshot_gradio_app.py" "$@"
